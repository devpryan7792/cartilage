#!/usr/bin/env bash

build() {
    add_module 'exfat'
    add_module 'erofs'
    add_module 'loop'
    add_module 'ext4'
    add_module 'virtio_blk'
    add_module 'virtio_pci'
    add_binary 'blkid'
    SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    HUB_LOADER="$(cd "${SCRIPT_DIR}/../.." && pwd)/cartilage/hub_loader.sh"
    if [[ ! -f "$HUB_LOADER" ]]; then
        HUB_LOADER="/home/pryan/code/cartrige/src/cartilage/hub_loader.sh"
    fi
    add_file "$HUB_LOADER" "/hub_loader.sh" 755
    add_runscript
}

help() {
    cat <<HELPEOF
Cartilage OS Dynamic Hub bootstrap hook.
Discovers CARTRIDGES exFAT volume, renders TTY text menu, loop-mounts chosen appliance.
HELPEOF
}
