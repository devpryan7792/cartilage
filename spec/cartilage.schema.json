{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CartilageApplianceManifest",
  "description": "Schema for Cartilage OS declarative appliance recipes and cartridge manifests",
  "type": "object",
  "required": ["appliance", "runtime", "display", "storage", "hardware"],
  "additionalProperties": false,
  "properties": {
    "appliance": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9_-]+$",
          "description": "Unique identifier of the appliance (lowercase alphanumeric, hyphens, underscores)"
        },
        "version": {
          "type": "string",
          "description": "Semantic version of the appliance package"
        },
        "description": {
          "type": "string",
          "description": "Short human-readable summary of the appliance functionality"
        },
        "author": {
          "type": "string",
          "description": "Maintainer or organization name"
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["engine"],
      "additionalProperties": false,
      "properties": {
        "engine": {
          "type": "string",
          "enum": ["alpine", "arch"],
          "description": "Target base OS runtime environment"
        },
        "packages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "System packages to install into the cartridge rootfs"
        },
        "environment": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Environment variables exported before application launch"
        }
      }
    },
    "display": {
      "type": "object",
      "required": ["entrypoint"],
      "additionalProperties": false,
      "properties": {
        "compositor": {
          "type": "string",
          "enum": ["cage", "sway", "none"],
          "default": "cage",
          "description": "Wayland compositor to manage the appliance window"
        },
        "mode": {
          "type": "string",
          "enum": ["desktop", "kiosk"],
          "default": "desktop",
          "description": "Display layout mode: desktop windowed or full-screen kiosk"
        },
        "entrypoint": {
          "type": "string",
          "description": "Executable path or binary name launched by the compositor"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Command line arguments passed directly to the entrypoint binary"
        }
      }
    },
    "storage": {
      "type": "object",
      "required": ["mode"],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["ephemeral", "persistent", "host-access"],
          "description": "Data storage persistence model"
        },
        "quota": {
          "type": "string",
          "pattern": "^[0-9]+[KMGkmg]?$",
          "description": "Maximum size quota for the writable overlay/storage partition"
        },
        "mount_point": {
          "type": "string",
          "default": "/data",
          "description": "Target mount path inside the cartridge filesystem"
        }
      }
    },
    "hardware": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "network": {
          "type": "boolean",
          "default": false,
          "description": "Enable networking subsystem (DHCP client, DNS, virtio-net)"
        },
        "audio": {
          "type": "boolean",
          "default": false,
          "description": "Enable ALSA sound subsystem and dmix audio device"
        },
        "acceleration": {
          "type": "string",
          "enum": ["auto", "virtio-gpu", "intel", "amd", "software"],
          "default": "auto",
          "description": "Graphics acceleration driver mode"
        },
        "memory": {
          "type": "string",
          "pattern": "^[0-9]+[MGmg]?$",
          "default": "1024M",
          "description": "Allocated RAM for virtual appliance execution"
        },
        "cores": {
          "type": "integer",
          "minimum": 1,
          "default": 2,
          "description": "Number of vCPU cores assigned to the appliance"
        }
      }
    }
  }
}
