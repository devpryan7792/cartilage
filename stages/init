#!/bin/bash
# Cartilage OS — Modular Stage Runner (PID 1)
# Zero-panic, fault-tolerant entry point for all cartridges.

set -uo pipefail

echo "============================================================"
echo "[init] Cartilage OS Appliance Initializing (PID 1)"
echo "============================================================"

# Error boundary to prevent kernel panic
trap 'echo "[init] [WARN] Caught error in execution, continuing boot..."' ERR

STAGE_DIR="/init.d"
if [[ ! -d "$STAGE_DIR" ]]; then
    if [[ -d "/etc/init.d" ]]; then
        STAGE_DIR="/etc/init.d"
    else
        STAGE_DIR=""
    fi
fi

if [[ -n "$STAGE_DIR" ]]; then
    for stage in $(ls -1 "$STAGE_DIR"/*.sh 2>/dev/null | sort); do
        if [[ -f "$stage" ]]; then
            echo "[init] -> Executing stage: $(basename "$stage")"
            # Source stage within error boundary
            source "$stage" || echo "[init] [WARN] Stage $(basename "$stage") returned $?, continuing..."
        fi
    done
else
    echo "[init] [WARN] No /init.d stage directory found!"
fi

echo "[init] Appliance session finished. Halting system..."
sync
poweroff -f 2>/dev/null || reboot -f
