# ==============================================================================
# Cartilage OS — Minimalist i3/Sway Compositor Configuration
# 100% i3-compatible, ultra-low memory, zero desktop bloat
# ==============================================================================

# Modifier: Alt (Mod1) for universal laptop/keyboard compatibility
set $mod Mod1

# Typography
font pango:monospace 10

# Window styling: crisp 3px border with distinct Tokyo Night focus colors
default_border pixel 3
default_floating_border pixel 3
hide_edge_borders none

# Focus palette: glowing cyan/blue for active window, muted dark slate for inactive
client.focused          #7aa2f7 #7aa2f7 #16161e #2ac3de #7aa2f7
client.focused_inactive #24283b #24283b #a9b1d6 #24283b #24283b
client.unfocused        #1a1b26 #1a1b26 #565f89 #1a1b26 #1a1b26
client.urgent           #f7768e #f7768e #ffffff #f7768e #f7768e

# Drag floating windows with Alt + Left Mouse Click
floating_modifier $mod normal

# Target applications
set $term /usr/bin/foot /bin/bash
set $browser /usr/bin/dillo
set $editor /usr/bin/mousepad
set $media /usr/bin/mpv --player-operation-mode=pseudo-gui --idle=yes

# Workspaces: 1:term (Terminal), 2:web (Browser), 3:code (Editor), 4:media (Player)
set $ws1 "1:term"
set $ws2 "2:web"
set $ws3 "3:code"
set $ws4 "4:media"

# Keybindings: Application spawning & management
bindsym $mod+Return exec $term
bindsym $mod+d exec /usr/bin/dillo https://duckduckgo.com
bindsym $mod+m exec /usr/bin/mousepad
bindsym $mod+p exec $media
bindsym $mod+v exec /usr/bin/vlc
bindsym $mod+Shift+q kill

# Keybindings: Workspace navigation
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4

# Focus navigation (vi-keys and arrows)
bindsym $mod+h focus left
bindsym $mod+j focus down
bindsym $mod+k focus up
bindsym $mod+l focus right
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# Move container
bindsym $mod+Shift+h move left
bindsym $mod+Shift+j move down
bindsym $mod+Shift+k move up
bindsym $mod+Shift+l move right

# Split toggles
bindsym $mod+b splith
bindsym $mod+v splitv
bindsym $mod+e layout toggle split
bindsym $mod+f fullscreen toggle
bindsym $mod+Shift+space floating toggle

# Clean appliance termination via sway exit (trapped by PID 1 for poweroff)
bindsym $mod+Shift+e exec swaymsg exit

# Explicitly enable Xwayland for graphical X11 tools (Dillo)
xwayland enable

# Assign applications to dedicated workspaces
assign [app_id="foot"] number $ws1
assign [class="(?i)dillo"] number $ws2
assign [app_id="chromium"] number $ws2
assign [class="Chromium"] number $ws2
assign [class="(?i)mousepad"] number $ws3
assign [app_id="(?i)mousepad"] number $ws3
assign [class="(?i)mpv"] number $ws4
assign [app_id="(?i)mpv"] number $ws4
assign [class="(?i)vlc"] number $ws4

# Autostart initial developer workstation session (Foot on ws1, Dillo on ws2, Mousepad on ws3)
exec $term
exec /usr/bin/dillo https://duckduckgo.com
exec which /usr/bin/mousepad >/dev/null 2>&1 && /usr/bin/mousepad

# Status Bar (swaybar) with workspace tabs and keybinding cheatsheet
bar {
    position bottom
    swaybar_command swaybar
    status_command /usr/bin/cartilage-status
    colors {
        statusline #c0caf5
        background #16161e
        focused_workspace #7aa2f7 #7aa2f7 #16161e
        active_workspace #3b4261 #3b4261 #c0caf5
        inactive_workspace #16161e #16161e #565f89
        urgent_workspace #f7768e #f7768e #ffffff
    }
}
