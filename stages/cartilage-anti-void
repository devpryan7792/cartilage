#!/bin/bash
# Cartilage Anti-Void Guardian Daemon
# Ensures the user is NEVER stranded on an empty workspace or blank screen.

export SWAYSOCK="${XDG_RUNTIME_DIR}/sway-ipc.${UID}.sock"
[[ ! -e "$SWAYSOCK" ]] && SWAYSOCK=$(ls -t /run/user/1000/sway-ipc.*.sock 2>/dev/null | head -1)

# Wait for Sway socket to become available
for i in {1..30}; do
    [[ -S "$SWAYSOCK" ]] && break
    sleep 0.2
    SWAYSOCK=$(ls -t /run/user/1000/sway-ipc.*.sock 2>/dev/null | head -1)
done

# Listen to window closing events via Sway IPC
swaymsg -m -t subscribe '["window"]' 2>/dev/null | while read -r line; do
    if echo "$line" | grep -q '"change":"close"'; then
        sleep 0.15
        TREE=$(swaymsg -t get_tree 2>/dev/null)
        NUM_WINDOWS=$(echo "$TREE" | grep -E '"app_id":|"window":' | grep -v 'null' | wc -l)
        if [ "$NUM_WINDOWS" -eq 0 ]; then
            # Entire screen is empty! Instantly switch to WS 1 and pop up Quick Menu
            swaymsg "workspace number 1:term" 2>/dev/null || true
            /usr/bin/foot --title="Cartilage Menu" --app-id="cartilage-menu" /usr/bin/cartilage-menu &
        else
            # Check if active workspace has no focused/visible windows
            FOCUSED_WS=$(swaymsg -t get_workspaces 2>/dev/null | grep -B 2 -A 5 '"focused":true' | grep '"name":' | head -1 | cut -d'"' -f4)
            # If current workspace has no windows and is not Workspace 1, guide user back to Workspace 1
            if [[ -n "$FOCUSED_WS" && "$FOCUSED_WS" != "1:term" ]]; then
                WS_WINDOWS=$(echo "$TREE" | grep -A 20 "\"name\":\"$FOCUSED_WS\"" | grep -E '"app_id":|"window":' | grep -v 'null' | wc -l)
                if [ "$WS_WINDOWS" -eq 0 ]; then
                    swaymsg "workspace number 1:term" 2>/dev/null || true
                fi
            fi
        fi
    fi
done
